IDENTIFICATION DIVISION.
PROGRAM-ID. HTTP-REQUEST.

ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
REPOSITORY.
    FUNCTION ALL INTRINSIC.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 LINE-TEXT                   PIC X(2048).
01 LINE-LEN                    PIC S9(9) COMP-5 VALUE 0.
01 LINE-END                    PIC S9(9) COMP-5 VALUE 0.
01 SPACE-ONE                   PIC S9(9) COMP-5 VALUE 0.
01 SPACE-TWO                   PIC S9(9) COMP-5 VALUE 0.
01 METHOD-LEN                  PIC S9(9) COMP-5 VALUE 0.
01 RAW-PATH                    PIC X(1024).
01 RAW-PATH-LEN                PIC S9(9) COMP-5 VALUE 0.
01 DECODED                     PIC X(1024).
01 DECODED-LEN                 PIC S9(9) COMP-5 VALUE 0.
01 POS                         PIC S9(9) COMP-5 VALUE 0.
01 SEG-START                   PIC S9(9) COMP-5 VALUE 0.
01 SEG-LEN                     PIC S9(9) COMP-5 VALUE 0.
01 HEX-CHAR                    PIC X VALUE SPACE.
01 HIGH-NIBBLE                 PIC S9(4) COMP-5 VALUE 0.
01 LOW-NIBBLE                  PIC S9(4) COMP-5 VALUE 0.
01 HEX-VALUE                   PIC S9(4) COMP-5 VALUE 0.

LINKAGE SECTION.
COPY "http.cpy".

PROCEDURE DIVISION USING SERVER-CONTEXT.
PARSE-REQUEST.
    MOVE 0 TO REQ-STATUS
    MOVE "N" TO REQ-HEAD-ONLY
    MOVE SPACES TO REQ-METHOD
    MOVE SPACES TO REQ-PATH
    MOVE 0 TO REQ-PATH-LEN
    PERFORM FIND-REQUEST-LINE
    IF REQ-STATUS = 0
        PERFORM SPLIT-REQUEST-LINE
    END-IF
    IF REQ-STATUS = 0
        PERFORM CHECK-METHOD
    END-IF
    IF REQ-STATUS = 0
        PERFORM DECODE-PATH
    END-IF
    IF REQ-STATUS = 0
        PERFORM NORMALISE-PATH
    END-IF
    EXIT PROGRAM.

FIND-REQUEST-LINE.
    MOVE 0 TO LINE-END
    PERFORM VARYING POS FROM 1 BY 1
        UNTIL POS >= REQ-RAW-LEN OR LINE-END > 0
        IF REQ-RAW(POS:2) = X"0D0A"
            MOVE POS TO LINE-END
        END-IF
    END-PERFORM
    IF LINE-END < 2 OR LINE-END > 2049
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    COMPUTE LINE-LEN = LINE-END - 1
    MOVE SPACES TO LINE-TEXT
    MOVE REQ-RAW(1:LINE-LEN) TO LINE-TEXT.

SPLIT-REQUEST-LINE.
    MOVE 0 TO SPACE-ONE
    MOVE 0 TO SPACE-TWO
    PERFORM VARYING POS FROM 1 BY 1 UNTIL POS > LINE-LEN
        IF LINE-TEXT(POS:1) = SPACE
            IF SPACE-ONE = 0
                MOVE POS TO SPACE-ONE
            ELSE
                IF SPACE-TWO = 0
                    MOVE POS TO SPACE-TWO
                END-IF
            END-IF
        END-IF
    END-PERFORM
    IF SPACE-ONE < 2 OR SPACE-TWO <= SPACE-ONE
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    COMPUTE METHOD-LEN = SPACE-ONE - 1
    IF METHOD-LEN > 8
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE LINE-TEXT(1:METHOD-LEN) TO REQ-METHOD
    COMPUTE RAW-PATH-LEN = SPACE-TWO - SPACE-ONE - 1
    IF RAW-PATH-LEN < 1 OR RAW-PATH-LEN > 1024
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    IF SPACE-TWO + 5 > LINE-LEN
        OR LINE-TEXT(SPACE-TWO + 1:5) NOT = "HTTP/"
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO RAW-PATH
    MOVE SPACES TO REQ-QUERY
    MOVE 0 TO REQ-QUERY-LEN
    MOVE LINE-TEXT(SPACE-ONE + 1:RAW-PATH-LEN) TO RAW-PATH
    PERFORM VARYING POS FROM 1 BY 1 UNTIL POS > RAW-PATH-LEN
        IF RAW-PATH(POS:1) = "?"
            IF POS < RAW-PATH-LEN AND RAW-PATH-LEN - POS <= 128
                COMPUTE REQ-QUERY-LEN = RAW-PATH-LEN - POS
                MOVE RAW-PATH(POS + 1:REQ-QUERY-LEN) TO REQ-QUERY
            END-IF
            COMPUTE RAW-PATH-LEN = POS - 1
            EXIT PERFORM
        END-IF
    END-PERFORM
    IF RAW-PATH-LEN < 1 OR RAW-PATH(1:1) NOT = "/"
        MOVE 400 TO REQ-STATUS
    END-IF.

CHECK-METHOD.
    EVALUATE REQ-METHOD
        WHEN "GET"
            MOVE "N" TO REQ-HEAD-ONLY
        WHEN "HEAD"
            MOVE "Y" TO REQ-HEAD-ONLY
        WHEN "POST"
            MOVE "N" TO REQ-HEAD-ONLY
        WHEN OTHER
            MOVE 405 TO REQ-STATUS
    END-EVALUATE.

DECODE-PATH.
    MOVE SPACES TO DECODED
    MOVE 0 TO DECODED-LEN
    MOVE 1 TO POS
    PERFORM UNTIL POS > RAW-PATH-LEN OR REQ-STATUS NOT = 0
        EVALUATE RAW-PATH(POS:1)
            WHEN "%"
                PERFORM DECODE-PERCENT
            WHEN "\"
                MOVE 400 TO REQ-STATUS
            WHEN OTHER
                PERFORM APPEND-DECODED-BYTE
                ADD 1 TO POS
        END-EVALUATE
    END-PERFORM
    IF REQ-STATUS = 0 AND DECODED-LEN < 1
        MOVE 400 TO REQ-STATUS
    END-IF.

DECODE-PERCENT.
    IF POS + 2 > RAW-PATH-LEN
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE RAW-PATH(POS + 1:1) TO HEX-CHAR
    PERFORM HEX-NIBBLE
    MOVE LOW-NIBBLE TO HIGH-NIBBLE
    MOVE RAW-PATH(POS + 2:1) TO HEX-CHAR
    PERFORM HEX-NIBBLE
    IF HIGH-NIBBLE < 0 OR LOW-NIBBLE < 0
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    COMPUTE HEX-VALUE = HIGH-NIBBLE * 16 + LOW-NIBBLE
    IF HEX-VALUE < 32
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION CHAR(HEX-VALUE + 1) TO RAW-PATH(POS:1)
    PERFORM APPEND-DECODED-BYTE
    ADD 3 TO POS.

HEX-NIBBLE.
    MOVE UPPER-CASE(HEX-CHAR) TO HEX-CHAR
    MOVE -1 TO LOW-NIBBLE
    IF HEX-CHAR >= "0" AND HEX-CHAR <= "9"
        COMPUTE LOW-NIBBLE = ORD(HEX-CHAR) - ORD("0")
    END-IF
    IF HEX-CHAR >= "A" AND HEX-CHAR <= "F"
        COMPUTE LOW-NIBBLE = ORD(HEX-CHAR) - ORD("A") + 10
    END-IF.

APPEND-DECODED-BYTE.
    IF DECODED-LEN >= 1024
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO DECODED-LEN
    MOVE RAW-PATH(POS:1) TO DECODED(DECODED-LEN:1).

NORMALISE-PATH.
    MOVE 1 TO POS
    PERFORM UNTIL POS > DECODED-LEN OR REQ-STATUS NOT = 0
        PERFORM UNTIL POS > DECODED-LEN
            OR DECODED(POS:1) NOT = "/"
            ADD 1 TO POS
        END-PERFORM
        IF POS <= DECODED-LEN
            MOVE POS TO SEG-START
            PERFORM UNTIL POS > DECODED-LEN
                OR DECODED(POS:1) = "/"
                ADD 1 TO POS
            END-PERFORM
            COMPUTE SEG-LEN = POS - SEG-START
            IF (SEG-LEN = 1 AND DECODED(SEG-START:1) = ".")
                OR (SEG-LEN = 2 AND DECODED(SEG-START:2) = "..")
                MOVE 400 TO REQ-STATUS
            ELSE
                IF REQ-PATH-LEN + SEG-LEN + 1 > 1024
                    MOVE 400 TO REQ-STATUS
                ELSE
                    ADD 1 TO REQ-PATH-LEN
                    MOVE "/" TO REQ-PATH(REQ-PATH-LEN:1)
                    MOVE DECODED(SEG-START:SEG-LEN)
                        TO REQ-PATH(REQ-PATH-LEN + 1:SEG-LEN)
                    ADD SEG-LEN TO REQ-PATH-LEN
                END-IF
            END-IF
        END-IF
    END-PERFORM
    IF REQ-STATUS NOT = 0
        EXIT PARAGRAPH
    END-IF
    IF REQ-PATH-LEN = 0
        MOVE "/" TO REQ-PATH
        MOVE 1 TO REQ-PATH-LEN
    END-IF.

END PROGRAM HTTP-REQUEST.
