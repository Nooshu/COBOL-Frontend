IDENTIFICATION DIVISION.
PROGRAM-ID. GOVUK-SERVER.

ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
REPOSITORY.
    FUNCTION ALL INTRINSIC.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "config.cpy".
COPY "http.cpy".

01 LISTENER-FD                 PIC S9(9) COMP-5 VALUE -1.
01 CLIENT-FD                   PIC S9(9) COMP-5 VALUE -1.
01 READ-COUNT                  PIC S9(9) COMP-5 VALUE 0.
01 ONE-BYTE                    PIC X VALUE SPACE.
01 READ-ONE                    PIC S9(9) COMP-5 VALUE 1.
01 PATH-LIMIT                  PIC S9(9) COMP-5 VALUE 4096.
01 ROOT-Z                      PIC X(513).
01 HEADERS-DONE                PIC X VALUE "N".
01 CLIENT-OPEN                 PIC X VALUE "Y".
01 PORT-TEXT                   PIC Z(4)9.
01 REQUEST-LENGTH              PIC S9(9) COMP-5 VALUE 0.
01 HEADER-POS                  PIC S9(9) COMP-5 VALUE 0.
01 DIGIT-POS                   PIC S9(9) COMP-5 VALUE 0.
01 LOW-RAW                     PIC X(8192).
01 FOUND-LENGTH                PIC X VALUE "N".

PROCEDURE DIVISION.
MAIN-SECTION.
    PERFORM LOAD-CONFIGURATION
    PERFORM OPEN-DOCUMENT-ROOT
    PERFORM OPEN-LISTENER
    DISPLAY "Listening on port " TRIM(PORT-TEXT)
    DISPLAY "Document root: " CANON-ROOT(1:CANON-ROOT-LEN)
    CALL "GWS_FLUSH"
    PERFORM SERVE-REQUESTS
    STOP RUN.

LOAD-CONFIGURATION.
    MOVE SPACES TO ENV-VALUE
    ACCEPT ENV-VALUE FROM ENVIRONMENT "PORT"
    IF TRIM(ENV-VALUE) NOT = SPACES
        IF TEST-NUMVAL(TRIM(ENV-VALUE)) = 0
            COMPUTE SERVER-PORT = NUMVAL(TRIM(ENV-VALUE))
        ELSE
            DISPLAY "PORT is not a number"
            STOP RUN RETURNING 1
        END-IF
    END-IF
    IF SERVER-PORT < 1 OR SERVER-PORT > 65535
        DISPLAY "PORT must be between 1 and 65535"
        STOP RUN RETURNING 1
    END-IF
    MOVE SERVER-PORT TO PORT-TEXT

    MOVE SPACES TO ENV-VALUE
    ACCEPT ENV-VALUE FROM ENVIRONMENT "DOCUMENT_ROOT"
    IF TRIM(ENV-VALUE) NOT = SPACES
        MOVE TRIM(ENV-VALUE) TO DOCUMENT-ROOT
        COMPUTE DOCUMENT-ROOT-LEN = LENGTH(TRIM(ENV-VALUE))
    END-IF
    IF DOCUMENT-ROOT-LEN > 1
        AND DOCUMENT-ROOT(DOCUMENT-ROOT-LEN:1) = "/"
        MOVE SPACE TO DOCUMENT-ROOT(DOCUMENT-ROOT-LEN:1)
        SUBTRACT 1 FROM DOCUMENT-ROOT-LEN
    END-IF.

OPEN-DOCUMENT-ROOT.
    MOVE SPACES TO ROOT-Z
    MOVE DOCUMENT-ROOT(1:DOCUMENT-ROOT-LEN) TO ROOT-Z
    MOVE LOW-VALUE TO ROOT-Z(DOCUMENT-ROOT-LEN + 1:1)
    MOVE SPACES TO CANON-ROOT
    CALL "GWS_REALPATH" USING
        BY REFERENCE ROOT-Z
        BY REFERENCE CANON-ROOT
        BY VALUE PATH-LIMIT
        RETURNING CANON-ROOT-LEN
    IF CANON-ROOT-LEN < 1
        DISPLAY "Document root does not exist: "
            DOCUMENT-ROOT(1:DOCUMENT-ROOT-LEN)
        STOP RUN RETURNING 1
    END-IF.

OPEN-LISTENER.
    CALL "GWS_LISTEN" USING
        BY VALUE SERVER-PORT
        RETURNING LISTENER-FD
    IF LISTENER-FD < 0
        DISPLAY "Could not listen on port " TRIM(PORT-TEXT)
        STOP RUN RETURNING 1
    END-IF.

SERVE-REQUESTS.
    PERFORM UNTIL LISTENER-FD < 0
        CALL "GWS_ACCEPT" USING
            BY VALUE LISTENER-FD
            RETURNING CLIENT-FD
        IF CLIENT-FD < 0
            DISPLAY "Accept failed"
            STOP RUN RETURNING 1
        END-IF
        PERFORM HANDLE-CLIENT
        CALL "GWS_CLOSE" USING BY VALUE CLIENT-FD
    END-PERFORM.

HANDLE-CLIENT.
    INITIALIZE HTTP-REQUEST
    INITIALIZE HTTP-RESPONSE
    MOVE "N" TO RES-HAS-FILE
    MOVE "N" TO REQ-HEAD-ONLY
    MOVE "N" TO RES-HEAD-ONLY
    PERFORM READ-HEADERS
    IF CLIENT-OPEN = "N" AND REQ-RAW-LEN = 0
        EXIT PARAGRAPH
    END-IF
    IF HEADERS-DONE NOT = "Y"
        MOVE 400 TO REQ-STATUS
    END-IF
    IF REQ-STATUS = 0
        CALL "HTTP-REQUEST" USING SERVER-CONTEXT
    END-IF
    IF REQ-STATUS = 0 AND REQ-METHOD = "POST"
        PERFORM READ-BODY
    END-IF
    IF REQ-STATUS = 0
        CALL "JOURNEY" USING SERVER-CONTEXT
    END-IF
    IF REQ-STATUS NOT = 0
        MOVE REQ-STATUS TO RES-STATUS
    ELSE
        IF RES-STATUS = 0
            CALL "STATIC-FILE" USING SERVER-CONTEXT
        END-IF
    END-IF
    MOVE REQ-HEAD-ONLY TO RES-HEAD-ONLY
    CALL "HTTP-RESPONSE" USING SERVER-CONTEXT CLIENT-FD
    DISPLAY TRIM(REQ-METHOD) " " TRIM(REQ-PATH) " " RES-STATUS
    CALL "GWS_FLUSH".

READ-HEADERS.
    MOVE 0 TO REQ-RAW-LEN
    MOVE "N" TO HEADERS-DONE
    MOVE "Y" TO CLIENT-OPEN
    PERFORM UNTIL HEADERS-DONE = "Y" OR CLIENT-OPEN = "N"
        CALL "GWS_READ" USING
            BY VALUE CLIENT-FD
            BY REFERENCE ONE-BYTE
            BY VALUE READ-ONE
            RETURNING READ-COUNT
        IF READ-COUNT <= 0
            MOVE "N" TO CLIENT-OPEN
        ELSE
            IF REQ-RAW-LEN >= 8192
                MOVE 400 TO REQ-STATUS
                MOVE "Y" TO HEADERS-DONE
            ELSE
                ADD 1 TO REQ-RAW-LEN
                MOVE ONE-BYTE TO REQ-RAW(REQ-RAW-LEN:1)
                IF REQ-RAW-LEN >= 4
                    AND REQ-RAW(REQ-RAW-LEN - 3:4) = X"0D0A0D0A"
                    MOVE "Y" TO HEADERS-DONE
                END-IF
            END-IF
        END-IF
    END-PERFORM.

READ-BODY.
    MOVE 0 TO REQ-BODY-LEN
    MOVE 0 TO REQUEST-LENGTH
    MOVE "N" TO FOUND-LENGTH
    IF REQ-RAW-LEN > 15
        MOVE LOWER-CASE(REQ-RAW(1:REQ-RAW-LEN)) TO LOW-RAW
        PERFORM VARYING HEADER-POS FROM 1 BY 1
            UNTIL HEADER-POS > REQ-RAW-LEN - 15 OR FOUND-LENGTH = "Y"
            IF LOW-RAW(HEADER-POS:15) = "content-length:"
                MOVE "Y" TO FOUND-LENGTH
                COMPUTE DIGIT-POS = HEADER-POS + 15
                PERFORM UNTIL DIGIT-POS > REQ-RAW-LEN
                    OR LOW-RAW(DIGIT-POS:1) NOT = SPACE
                    ADD 1 TO DIGIT-POS
                END-PERFORM
                IF DIGIT-POS > REQ-RAW-LEN
                    OR LOW-RAW(DIGIT-POS:1) < "0"
                    OR LOW-RAW(DIGIT-POS:1) > "9"
                    MOVE 400 TO REQ-STATUS
                    EXIT PARAGRAPH
                END-IF
                PERFORM UNTIL DIGIT-POS > REQ-RAW-LEN
                    OR LOW-RAW(DIGIT-POS:1) < "0"
                    OR LOW-RAW(DIGIT-POS:1) > "9"
                    COMPUTE REQUEST-LENGTH = REQUEST-LENGTH * 10
                        + ORD(LOW-RAW(DIGIT-POS:1)) - ORD("0")
                    ADD 1 TO DIGIT-POS
                END-PERFORM
            END-IF
        END-PERFORM
    END-IF
    IF REQUEST-LENGTH > 4096
        MOVE 400 TO REQ-STATUS
        EXIT PARAGRAPH
    END-IF
    PERFORM UNTIL REQ-BODY-LEN >= REQUEST-LENGTH
        CALL "GWS_READ" USING
            BY VALUE CLIENT-FD
            BY REFERENCE ONE-BYTE
            BY VALUE READ-ONE
            RETURNING READ-COUNT
        IF READ-COUNT <= 0
            MOVE 400 TO REQ-STATUS
            EXIT PARAGRAPH
        END-IF
        ADD 1 TO REQ-BODY-LEN
        MOVE ONE-BYTE TO REQ-BODY(REQ-BODY-LEN:1)
    END-PERFORM.

END PROGRAM GOVUK-SERVER.
