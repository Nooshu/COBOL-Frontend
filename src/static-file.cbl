IDENTIFICATION DIVISION.
PROGRAM-ID. STATIC-FILE.

ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
REPOSITORY.
    FUNCTION ALL INTRINSIC.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 FULL-PATH                   PIC X(4112).
01 RESOLVED                    PIC X(4096).
01 RESOLVED-LEN                PIC S9(9) COMP-5 VALUE 0.
01 PATH-LIMIT                  PIC S9(9) COMP-5 VALUE 4096.
01 FILE-SIZE                   PIC S9(9) COMP-5 VALUE 0.
01 IS-DIRECTORY                PIC X VALUE "N".
01 TRIED-INDEX                 PIC X VALUE "N".

LINKAGE SECTION.
COPY "http.cpy".

PROCEDURE DIVISION USING SERVER-CONTEXT.
SERVE-PATH.
    MOVE "N" TO RES-HAS-FILE
    MOVE 0 TO RES-STATUS
    MOVE "N" TO TRIED-INDEX
    IF REQ-PATH-LEN < 1
        OR CANON-ROOT-LEN + REQ-PATH-LEN >= 4096
        MOVE 400 TO RES-STATUS
        EXIT PROGRAM
    END-IF
    MOVE SPACES TO FULL-PATH
    MOVE CANON-ROOT(1:CANON-ROOT-LEN) TO FULL-PATH(1:CANON-ROOT-LEN)
    MOVE REQ-PATH(1:REQ-PATH-LEN)
        TO FULL-PATH(CANON-ROOT-LEN + 1:REQ-PATH-LEN)
    MOVE LOW-VALUE TO FULL-PATH(CANON-ROOT-LEN + REQ-PATH-LEN + 1:1)
    PERFORM RESOLVE-CANDIDATE
    IF IS-DIRECTORY = "Y"
        PERFORM APPEND-INDEX
        IF RES-STATUS = 0
            PERFORM RESOLVE-CANDIDATE
        END-IF
    END-IF
    IF RES-STATUS = 0
        PERFORM FINISH-FILE
    END-IF
    EXIT PROGRAM.

RESOLVE-CANDIDATE.
    MOVE "N" TO IS-DIRECTORY
    MOVE SPACES TO RESOLVED
    CALL "GWS_REALPATH" USING
        BY REFERENCE FULL-PATH
        BY REFERENCE RESOLVED
        BY VALUE PATH-LIMIT
        RETURNING RESOLVED-LEN
    IF RESOLVED-LEN < 1
        MOVE 404 TO RES-STATUS
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-INSIDE
    IF RES-STATUS NOT = 0
        EXIT PARAGRAPH
    END-IF
    MOVE LOW-VALUE TO RESOLVED(RESOLVED-LEN + 1:1)
    CALL "GWS_FILE_SIZE" USING
        BY REFERENCE RESOLVED
        RETURNING FILE-SIZE
    IF FILE-SIZE = -2
        MOVE "Y" TO IS-DIRECTORY
        MOVE 404 TO RES-STATUS
    ELSE
        IF FILE-SIZE < 0
            MOVE 404 TO RES-STATUS
        ELSE
            MOVE 0 TO RES-STATUS
            MOVE FILE-SIZE TO RES-BODY-LEN
        END-IF
    END-IF.

CHECK-INSIDE.
    IF RESOLVED-LEN < CANON-ROOT-LEN
        MOVE 400 TO RES-STATUS
        EXIT PARAGRAPH
    END-IF
    IF RESOLVED(1:CANON-ROOT-LEN) NOT = CANON-ROOT(1:CANON-ROOT-LEN)
        MOVE 400 TO RES-STATUS
        EXIT PARAGRAPH
    END-IF
    IF CANON-ROOT-LEN > 1
        AND RESOLVED-LEN > CANON-ROOT-LEN
        AND RESOLVED(CANON-ROOT-LEN + 1:1) NOT = "/"
        MOVE 400 TO RES-STATUS
    END-IF.

APPEND-INDEX.
    IF TRIED-INDEX = "Y" OR RESOLVED-LEN + 12 > 4096
        MOVE 404 TO RES-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE "Y" TO TRIED-INDEX
    MOVE SPACES TO FULL-PATH
    MOVE RESOLVED(1:RESOLVED-LEN) TO FULL-PATH(1:RESOLVED-LEN)
    MOVE "/index.html" TO FULL-PATH(RESOLVED-LEN + 1:11)
    MOVE LOW-VALUE TO FULL-PATH(RESOLVED-LEN + 12:1)
    MOVE 0 TO RES-STATUS
    MOVE "N" TO IS-DIRECTORY.

FINISH-FILE.
    MOVE 200 TO RES-STATUS
    MOVE "Y" TO RES-HAS-FILE
    MOVE RESOLVED-LEN TO RES-FILE-PATH-LEN
    MOVE SPACES TO RES-FILE-PATH
    MOVE RESOLVED(1:RESOLVED-LEN) TO RES-FILE-PATH
    CALL "MIME-TYPES" USING SERVER-CONTEXT.

END PROGRAM STATIC-FILE.
